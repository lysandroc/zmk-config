#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
// | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | ESC  |
//                   | ALT | GUI | SPC |   | RET | MO1 | MO2 |
                        bindings = <
    &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T       &kp Y     &kp U     &kp I       &kp O     &kp P     &kp BSPC
    &kp LSHFT  &kp A     &kp S     &kp D     &kp F     &kp G       &kp H     &kp J     &kp K       &kp L     &kp SEMI  &kp SQT
    &kp LCTRL  &kp Z     &kp X     &kp C     &kp V     &kp B       &kp N     &kp M     &kp COMMA   &kp DOT   &kp FSLH  &kp ESC
                        &kp LALT &kp LGUI &kp SPACE    &kp RET   &mo 1   &mo 2
                        >;
                };
                /*studio_unlock_layer {
// -----------------------------------------------------------------------------------------
// Layer dedicated to unlocking ZMK Studio. All keys are transparent except
// the top‑left key, which issues the &studio_unlock behavior.
//
// |UNLCK|      |      |      |      |      |   |      |      |      |      |      |      |
// |     |      |      |      |      |      |   |      |      |      |      |      |      |
// |     |      |      |      |      |      |   |      |      |      |      |      |      |
//                    |      |      |      |   |      |      |      |
                        bindings = <
   &studio_unlock &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
   &trans         &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
   &trans         &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                   &trans &trans &trans   &trans &trans &trans
                        >;
                };*/
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  `~  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | SHFT |     |     |     | RGB- | RGB+ |   |  ←  |  ↓  |  ↑  |  →  | BRD- | BRD+ |
// | CTRL |     |     |     | SAT- | SAT+ |   | PREV | PLAY | NEXT | VOL- | MUTE | VOL+ |
//                   | ALT | GUI |     |   | RET | MO2 | MO1 |
                        bindings = <
   &kp GRAVE  &kp N1       &kp N2       &kp N3       &kp N4         &kp N5           &kp N6     &kp N7     &kp N8     &kp N9      &kp N0       &kp BSPC
   &kp LSHFT  &trans       &trans       &trans       &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT   &kp C_BRI_DN &kp C_BRI_UP
   &kp LCTRL  &trans       &trans       &trans       &rgb_ug RGB_SAD &rgb_ug RGB_SAI  &kp C_PREV &kp C_PP   &kp C_NEXT &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP
                                    &kp RALT     &kp LGUI       &trans      &kp RET  &mo 2   &mo 1
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |   `~   |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | SHFT |     |     |     |     |     |   |  _  |  =  |  {  |  }  |  \  |     |
// | CTRL |     |     |     |     |     |   |  -  |  +  |  [  |  ]  |     |      |
//                   | ALT | GUI | SPC |   | RET | MO1 | MO2 |
                        bindings = <
   &kp GRAVE &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LSHFT &trans   &trans   &trans   &trans   &trans      &kp UNDER &kp EQUAL &kp LBRC  &kp RBRC &kp BSLH &trans
   &kp LCTRL &trans   &trans   &trans   &trans   &trans      &kp MINUS &kp PLUS  &kp LBKT  &kp RBKT &trans   &trans
                              &kp LALT &kp LGUI &kp SPACE    &kp RET   &mo 1     &mo 2
                        >;
                };
        };
};
